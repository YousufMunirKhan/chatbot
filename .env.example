# ==========================================================================
#  AI Business Assistant SaaS — Environment Variables
#  Copy this file to `.env.local` (local dev) and fill in real values.
#  NEVER commit `.env.local`. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ==========================================================================

# --------------------------------------------------------------------------
# App
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget/widget.js
APP_ENV=development

# --------------------------------------------------------------------------
# Supabase (Postgres + pgvector + Realtime + Storage)
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Anon / public key — legacy JWT key OR new-format `sb_publishable_...` key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (backend only) — legacy JWT key OR new-format `sb_secret_...` key
SUPABASE_SERVICE_ROLE_KEY=
# Optional: JWKS endpoint for verifying Supabase-issued JWTs (Module 3 auth)
SUPABASE_JWKS_URL=
DATABASE_URL=

# --------------------------------------------------------------------------
# AI Providers (at least one is required; provider layer is switchable)
# --------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# --------------------------------------------------------------------------
# Default AI Settings (overridable per platform/company/bot via settings)
# --------------------------------------------------------------------------
DEFAULT_CHAT_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_ADVANCED_CHAT_MODEL=gpt-4o
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_RERANK_PROVIDER=cohere
DEFAULT_RERANK_MODEL=rerank-multilingual-v3.0

# --------------------------------------------------------------------------
# Stripe (billing, subscriptions, webhooks)
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --------------------------------------------------------------------------
# Trigger.dev (scheduled sync / ingestion / background jobs)
# --------------------------------------------------------------------------
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# --------------------------------------------------------------------------
# Email (Resend / SendGrid / SES — choose one)
# --------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --------------------------------------------------------------------------
# Shopify integration
# --------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers,write_draft_orders

# --------------------------------------------------------------------------
# WooCommerce integration
# --------------------------------------------------------------------------
WOOCOMMERCE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------
# 32-byte key, hex or base64. Used to encrypt integration tokens at rest.
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SUPPORT_ACCESS_REQUIRED=true

# --------------------------------------------------------------------------
# Redis (optional — rate limiting / caching)
# --------------------------------------------------------------------------
REDIS_URL=

# --------------------------------------------------------------------------
# Messaging channels
#
# Each channel's per-account token is entered on /company/channels and stored
# encrypted. The values below are APP-level and must be set in the environment.
# --------------------------------------------------------------------------

# Meta (WhatsApp, Facebook Messenger + feed, Instagram DM + comments).
# The verify token is any string you also paste into Meta's webhook form.
META_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# App secret from the Meta app dashboard. It is what proves an inbound webhook
# really came from Meta. WITHOUT IT, INBOUND WEBHOOKS ARE REJECTED IN
# PRODUCTION — anyone who learned the URL could otherwise post fake customer
# messages straight into your inbox and your customers' threads.
META_APP_SECRET=
WHATSAPP_APP_SECRET=

# TikTok for Business — signs comment webhooks. Same rule as Meta above.
TIKTOK_CLIENT_SECRET=

# Google OAuth — powers "Connect Gmail" on /company/channels and the
# Google Calendar integration. Add these redirect URIs to the OAuth client:
#   <app>/api/channels/gmail/callback
#   <app>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email for the email channel. Without these the assistant can read
# inbound mail but can never reply to it.
EMAIL_API_URL=
EMAIL_API_KEY=

# --------------------------------------------------------------------------
# Scheduled jobs
#
# Six background jobs are declared in vercel.json. Vercel sends this value as a
# bearer token automatically once it is set. WITHOUT IT EVERY JOB RETURNS 503:
# no reply-time warnings, no broadcasts, no order or abandoned-cart messages,
# no Gmail/YouTube polling, and no automatic credit top-up.
# --------------------------------------------------------------------------
CRON_SECRET=

# --------------------------------------------------------------------------
# Web push (dashboard PWA phone alerts)
#
# VAPID keys identify this server to Google/Mozilla/Apple's push services. They
# are a P-256 key pair, base64url-encoded. Generate a pair once per deployment
# and keep the private half secret — rotating it invalidates every device that
# has already subscribed, and they will each have to turn alerts on again.
#
#   node -e "const c=require('node:crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const p=publicKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(p.x,'base64url'),Buffer.from(p.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({format:'jwk'}).d)"
#
# VAPID_SUBJECT must be a contact URI (mailto: or https:) that the push service
# can use to reach you if this server misbehaves.
# WITHOUT THESE, PHONE ALERTS ARE OFF: the settings card says so plainly and
# nothing else is affected.
# --------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
