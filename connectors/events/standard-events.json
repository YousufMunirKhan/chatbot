      "optionalFields": [],
      "allowedRoles": ["admin", "manager", "cashier"],
      "needsConfirmation": false,
      "resultShape": { "product": "product summary" }
    },
    {
      "name": "create_product",
      "domain": "inventory",
      "description": "Create a product.",
      "type": "create",
      "risk": "medium",
      "requiredFields": ["name", "price"],
      "optionalFields": ["sku", "barcode", "category_id", "category_name", "opening_stock"],
      "allowedRoles": ["admin", "manager"],
      "needsConfirmation": true,
      "resultShape": { "success": "boolean", "product_id": "string", "message": "string" }
