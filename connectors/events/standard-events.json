    {
      "name": "search_product",
      "domain": "inventory",
      "description": "Search products by name, SKU, or barcode.",
      "type": "read",
      "risk": "low",
      "requiredFields": ["query"],
      "optionalFields": [],
      "allowedRoles": ["admin", "manager", "cashier"],
      "needsConfirmation": false,
      "resultShape": { "results": "array of product summaries" }
    },
    {
      "name": "get_product",
      "domain": "inventory",
