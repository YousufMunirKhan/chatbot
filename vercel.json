{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sla",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/channels",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/broadcasts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/insights",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron?task=sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron?task=jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron?task=cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron?task=improvement_emails",
      "schedule": "0 7 * * 1"
    }
  ]
}
